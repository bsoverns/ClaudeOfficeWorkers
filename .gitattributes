# Normalise text files to LF in the repo; check out with native line endings.
* text=auto

# Windows batch files must be CRLF or cmd misreads labels and goto.
*.bat text eol=crlf

*.ico binary
*.exe binary
*.png binary
*.zip binary
.githooks/* text eol=lf

# Mac launcher and double-click scripts must be LF or bash chokes on the \r.
*.sh text eol=lf
*.command text eol=lf
*.plist text eol=lf
package/mac/ClaudeOffice text eol=lf
*.icns binary
